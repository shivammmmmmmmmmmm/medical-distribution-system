# Local development value. Set this to the deployed backend URL in Vercel.
NEXT_PUBLIC_API_URL=http://localhost:3001/api
NEXT_PUBLIC_DEMO_MODE=true

# Server-only NextAuth configuration; never expose these as NEXT_PUBLIC_* values.
# NextAuth — required for Google & Facebook OAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=change-this-to-a-random-32-char-string

# Google OAuth — get from https://console.cloud.google.com
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# Facebook OAuth — get from https://developers.facebook.com
# Valid OAuth Redirect URI: http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret

