# Database: mysql (XAMPP) or sqlite (file in backend/data/)
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=medical_db
# Local development fallback only. Use a hosted MySQL database in production.
DB_FALLBACK_SQLITE=1
PORT=3001
FRONTEND_URL=http://localhost:3000
# For multiple frontend origins, use comma-separated FRONTEND_URLS instead.
# FRONTEND_URLS=http://localhost:3000,https://your-frontend.vercel.app
JWT_SECRET=change-this-to-a-long-random-secret
# Optional first-run admin bootstrap; keep the password server-side and remove after setup.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=replace-with-a-strong-one-time-password
NODE_ENV=development
